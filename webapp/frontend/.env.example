# Backend base URL (no trailing slash).
VITE_API_BASE=http://localhost:8080

# Must match the backend's API_CLIENT_ID / API_CLIENT_SECRET. Baked into the
# build — this is a coarse app-level gate, not a strong secret (see webapp/README.md).
VITE_API_CLIENT_ID=change-me
VITE_API_CLIENT_SECRET=change-me

# Local reader-agent WebSocket URL (operator's machine, loopback only).
VITE_READER_AGENT_URL=ws://127.0.0.1:17420/ws
