# Copy to .env (same directory as docker-compose.yml) and fill in real values.

# Shared secret between the frontend build and the backend — every API
# request must present these. Coarse app-level gate, not a strong secret
# (see README.md's auth-model section).
API_CLIENT_ID=change-me
API_CLIENT_SECRET=change-me

# Signs session cookies. Any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me

# Bootstraps the one hardcoded admin on first run only (ignored once any
# user account exists). Create additional accounts from the Admin page.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# The compose setup serves everything over plain HTTP by default (put a
# reverse proxy with TLS in front for anything beyond local/LAN use); leave
# this as-is unless you've done that.
COOKIE_SECURE=false

# Host port the webapp is published on.
FRONTEND_PORT=8000

# Only relevant if operators' reader-agents listen on a non-default port.
VITE_READER_AGENT_URL=ws://127.0.0.1:17420/ws
